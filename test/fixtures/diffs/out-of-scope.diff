+//! Vendored CSV reader (upstream copy, not first-party code).
+
+pub fn read_rows(path: &str) -> std::io::Result<Vec<Vec<String>>> {
+    let text = std::fs::read_to_string(path)?;
+    let started = std::time::Instant::now();
+    let rows = text.lines().map(|l| l.split(',').map(str::to_owned).collect()).collect();
+    log_elapsed(started.elapsed());
+    Ok(rows)
+}
+
+fn log_elapsed(d: std::time::Duration) {
+    eprintln!("csv-lite: parsed in {d:?}");
+}
