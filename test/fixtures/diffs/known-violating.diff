diff --git a/crates/ledger-core/src/aging.rs b/crates/ledger-core/src/aging.rs
index 595f078..20505c4 100644
--- a/crates/ledger-core/src/aging.rs
+++ b/crates/ledger-core/src/aging.rs
@@ -22,3 +22,13 @@ pub fn bucket_for(days_overdue: u32) -> Bucket {
 pub fn overdue_total(items: &[(u32, Cents)], bucket: Bucket) -> Cents {
     items.iter().filter(|(d, _)| bucket_for(*d) == bucket).map(|(_, c)| *c).sum()
 }
+
+/// Days an invoice issued at `issued_unix_s` is past its `net_days` terms.
+pub fn days_overdue(issued_unix_s: u64, net_days: u32) -> u32 {
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .expect("system clock before 1970")
+        .as_secs();
+    let age_days = (now.saturating_sub(issued_unix_s) / 86_400) as u32;
+    age_days.saturating_sub(net_days)
+}
diff --git a/crates/ledger-core/src/money.rs b/crates/ledger-core/src/money.rs
index dae5e1d..e65ea06 100644
--- a/crates/ledger-core/src/money.rs
+++ b/crates/ledger-core/src/money.rs
@@ -6,3 +6,9 @@ pub fn format_cents(c: Cents) -> String {
     let sign = if c < 0 { "-" } else { "" };
     format!("{sign}{}.{:02}", c.abs() / 100, c.abs() % 100)
 }
+
+/// Splits `total` into `parts` amounts that differ by at most one cent.
+pub fn split_even(total: Cents, parts: u32) -> Vec<Cents> {
+    let n = Cents::from(parts.max(1));
+    (0..n).map(|i| total / n + Cents::from(i < total % n)).collect()
+}
