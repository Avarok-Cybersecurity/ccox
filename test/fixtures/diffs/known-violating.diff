 //! Monthly statements: totals and line ordering for one account.
 
+use std::path::Path;
+
 use crate::money::Cents;
 
 #[derive(Debug, Clone, PartialEq, Eq)]
@@ -9,6 +11,18 @@ pub struct Entry {
     pub memo: String,
 }
 
+#[derive(Debug)]
+pub enum StatementError {
+    Io(std::io::Error),
+    BadLine(usize),
+}
+
+impl From<std::io::Error> for StatementError {
+    fn from(e: std::io::Error) -> Self {
+        StatementError::Io(e)
+    }
+}
+
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub struct Statement {
     pub account: String,
@@ -24,4 +38,25 @@ impl Statement {
         self.entries.sort_by_key(|e| e.posted_day);
         self
     }
+
+    /// Loads an account's statement from the nightly CSV export.
+    pub fn load(export_dir: &Path, account: &str) -> Result<Self, StatementError> {
+        let raw = std::fs::read_to_string(export_dir.join(format!("{account}.csv")))?;
+        Self::parse(account, &raw)
+    }
+
+    /// Parses `day,cents,memo` lines.
+    pub fn parse(account: &str, raw: &str) -> Result<Self, StatementError> {
+        let mut entries = Vec::new();
+        for (n, line) in raw.lines().enumerate() {
+            let mut cols = line.splitn(3, ',');
+            let (Some(day), Some(cents), Some(memo)) = (cols.next(), cols.next(), cols.next()) else {
+                return Err(StatementError::BadLine(n + 1));
+            };
+            let posted_day = day.parse().map_err(|_| StatementError::BadLine(n + 1))?;
+            let amount = cents.parse().map_err(|_| StatementError::BadLine(n + 1))?;
+            entries.push(Entry { posted_day, amount, memo: memo.to_owned() });
+        }
+        Ok(Self { account: account.to_owned(), entries })
+    }
 }
