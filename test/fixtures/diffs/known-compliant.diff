+//! ledger-cli: the composition root. Reads explicit configuration, builds the
+//! std adapters and hands them to the core.
+
+use std::path::PathBuf;
+use std::process::ExitCode;
+
+use ledger_core::statement::Statement;
+use ledger_io_std::FsStatementSource;
+
+fn main() -> ExitCode {
+    let Ok(dir) = std::env::var("LEDGER_EXPORT_DIR") else {
+        eprintln!("LEDGER_EXPORT_DIR is required");
+        return ExitCode::from(2);
+    };
+    let Some(account) = std::env::args().nth(1) else {
+        eprintln!("usage: ledger-cli <account>");
+        return ExitCode::from(2);
+    };
+    match Statement::load(&FsStatementSource::new(PathBuf::from(dir)), &account) {
+        Ok(s) => {
+            println!("{}", ledger_core::money::format_cents(s.total()));
+            ExitCode::SUCCESS
+        }
+        Err(e) => {
+            eprintln!("cannot load {account}: {e:?}");
+            ExitCode::FAILURE
+        }
+    }
+}
