+
+    /// Loads an account's statement through the injected source.
+    pub fn load<S: StatementSource>(source: &S, account: &str) -> Result<Self, StatementError> {
+        let raw = source.statement_csv(account).map_err(StatementError::Source)?;
+        let mut entries = Vec::new();
+        for (n, line) in raw.lines().enumerate() {
+            let cols: Vec<&str> = line.splitn(3, ',').collect();
+            let [day, cents, memo] = cols[..] else { return Err(StatementError::BadLine(n + 1)) };
+            let posted_day = day.parse().map_err(|_| StatementError::BadLine(n + 1))?;
+            let amount = cents.parse().map_err(|_| StatementError::BadLine(n + 1))?;
+            entries.push(Entry { posted_day, amount, memo: memo.to_owned() });
+        }
+        Ok(Self { account: account.to_owned(), entries })
+    }
+}
