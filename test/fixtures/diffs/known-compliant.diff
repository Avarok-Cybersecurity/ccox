+/// Days an invoice issued at `issued_unix_s` is past its `net_days` terms.
+pub fn days_overdue<C: Clock>(clock: &C, issued_unix_s: u64, net_days: u32) -> u32 {
+    let age_days = (clock.unix_seconds().saturating_sub(issued_unix_s) / 86_400) as u32;
+    age_days.saturating_sub(net_days)
+}
