+//! std-backed adapters for the ledger-core ports.
+
+use std::path::PathBuf;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use ledger_core::ports::{Clock, SourceError, StatementSource};
+
+/// Reads `<dir>/<account>.csv` from the nightly export directory.
+pub struct FsStatementSource {
+    dir: PathBuf,
+}
+
+impl FsStatementSource {
+    pub fn new(dir: PathBuf) -> Self {
+        Self { dir }
+    }
+}
+
+impl StatementSource for FsStatementSource {
+    fn statement_csv(&self, account: &str) -> Result<String, SourceError> {
+        std::fs::read_to_string(self.dir.join(format!("{account}.csv"))).map_err(|e| match e.kind() {
+            std::io::ErrorKind::NotFound => SourceError::NotFound,
+            _ => SourceError::Unreadable,
+        })
+    }
+}
+
+/// The operating-system clock.
+pub struct SystemClock;
+
+impl Clock for SystemClock {
+    fn unix_seconds(&self) -> u64 {
+        SystemTime::now().duration_since(UNIX_EPOCH).expect("system clock before 1970").as_secs()
+    }
+}
